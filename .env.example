# Django Core Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Database Configuration (Neon PostgreSQL / TiDB / Aiven MySQL)
# Option A: Paste full connection string (e.g. Neon PostgreSQL or Cloud MySQL)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Individual database credentials (Local MySQL)
DB_NAME=bookstore
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL_MODE=REQUIRED

# Cloudinary Media Storage (For book covers & user uploads on Render)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_PREFIX=DebSu-Lit_Book-Store_Group-Project

# Razorpay Payment Gateway Credentials (Test/Live)
RAZORPAY_API_KEY=rzp_test_xxxxxx
RAZORPAY_API_SECRET=xxxxxx
